# Copy to .env.local and set your private edit-mode password.
# Restart `npm run dev` after changing this file.
VITE_EDIT_PASSWORD=your-secret-password

# Optional: store a SHA-256 hash instead of plain text (run: npm run hash-edit-password)
# VITE_EDIT_PASSWORD_HASH=
# VITE_EDIT_PASSWORD_SALT=cynthia-portfolio-v1
